# Copy to backend/.env for local (non-Docker) runs. All values have safe defaults.

PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Product data source (swap the adapter in src/container.ts to change source type)
PRODUCT_SOURCE_URL=https://fakestoreapi.com
PRODUCT_SOURCE_TIMEOUT_MS=5000
PRODUCT_CACHE_TTL_MS=300000
CURRENCY=AUD

# Merchandising: the 5 products chosen as "top rated" for the home page, in order
FEATURED_PRODUCT_IDS=3,5,11,12,18
# How many top-rated products to highlight on each category page
CATEGORY_TOP_RATED_COUNT=3

# Email: "console" logs emails to the terminal; "smtp" sends via SMTP (Mailpit in docker compose)
EMAIL_PROVIDER=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SALES_INBOX=sales@example.com
EMAIL_FROM=no-reply@example.com

ENQUIRY_RATE_LIMIT_PER_15_MIN=10
